# Copy to the PVC code checkout as `.env` (gitignored), then chmod 600.
# Example:
#   cp .env.example /home/share/yzt/kimodo-reproduction/.env
#   chmod 600 /home/share/yzt/kimodo-reproduction/.env
#
# Already-set process environment variables are not overridden.
# Shared PVC is visible to others with share access — prefer platform Secrets
# when the cluster supports them.

# Weights & Biases (training + eval-watch)
WANDB_API_KEY=
# WANDB_ENTITY=
# WANDB_PROJECT=kimodo-reproduction

# MiMo / product-graph LLM (V2 data washing / repair only; not needed for train-company)
PRODUCT_GRAPH_LLM_API_KEY=
